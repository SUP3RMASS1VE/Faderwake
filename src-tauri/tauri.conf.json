{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faderwake",
  "version": "0.1.0",
  "identifier": "studio.sup3rmass1ve.faderwake",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Faderwake",
        "width": 1240,
        "height": 830,
        "minWidth": 740,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "A local desktop mastering studio",
    "resources": {
      "../assets/Half Light.wav": "assets/Half Light.wav",
      "../vendor/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt",
      "../vendor/FFmpeg-NOTICE.txt": "licenses/FFmpeg-NOTICE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/faderwake-ffmpeg",
      "binaries/faderwake-ffprobe"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "wave"
        ],
        "name": "WAV",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-wav"
      },
      {
        "ext": [
          "aif",
          "aiff",
          "aifc"
        ],
        "name": "AIFF",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-aiff"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "m4a",
          "alac",
          "mp4"
        ],
        "name": "MPEG-4 audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "AAC",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/aac"
      },
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "caf"
        ],
        "name": "Core Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-caf"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "Ogg audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "Opus",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/opus"
      },
      {
        "ext": [
          "wma"
        ],
        "name": "Windows Media Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-ms-wma"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "Faderwake.desktop",
        "depends": ["libasound2 | libasound2t64"]
      }
    }
  }
}
